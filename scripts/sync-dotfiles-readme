#!/usr/bin/env python3
"""Refresh the site's embedded dotfiles project from one Git commit."""

import argparse
import re
import subprocess
from pathlib import Path

args = argparse.ArgumentParser(description=__doc__)
args.add_argument("checkout", type=Path)
args.add_argument("revision", nargs="?", default="HEAD")
options = args.parse_args()
root = Path(__file__).resolve().parents[1]


def git(*args):
    return subprocess.check_output(["git", "-C", options.checkout, *args])


commit = git("rev-parse", "--verify", "--end-of-options",
             options.revision + "^{commit}").decode().strip()
readme = git("show", f"{commit}:README.md")
def screenshot_paths(markdown):
    paths = set(re.findall(r"!\[[^\]\n]*\]\(([^)\n]+)\)", markdown))
    for path in paths:
        if not re.fullmatch(r"screenshots/(?:[\w-]+/)*[\w-]+\.(?:png|jpe?g|webp)", path):
            raise SystemExit(f"Unsupported README image: {path}")
    return paths


images = {path: git("show", f"{commit}:{path}") for path in screenshot_paths(readme.decode())}

# Resolve all inputs before updating the previous snapshot.
snapshot = root / "content/dotfiles"
previous = screenshot_paths((snapshot / "README.md").read_text())
snapshot.mkdir(parents=True, exist_ok=True)
(snapshot / "README.md").write_bytes(readme)
(snapshot / "revision").write_text(commit + "\n")
assets = root / "public/dotfiles"
for path, data in images.items():
    target = assets / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
for path in previous - images.keys():
    (assets / path).unlink(missing_ok=True)
print(f"Synced README and {len(images)} screenshots from {commit}")
